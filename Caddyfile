www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy api:3001
  }

  root * /srv

  # Hashed assets: cache for 1 year
  @hashedAssets path /assets/*
  header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

  # index.html and SPA fallback: always revalidate
  @html path *.html /
  header @html Cache-Control "no-cache"

  file_server

  @notFile {
    not file
    not path /api/*
  }
  rewrite @notFile /index.html
}